{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Dask Workers",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "options": {
              "cwd": "${workspaceFolder}/docker",
              "env": {},
            },
            "args" : [
                "${workspaceFolder}/bin/start-dask.py",
                "--remote",
                "${input:remote}",
            ]
        },
        {
            "label": "Launch Devcontainer",
            "type": "shell",
            "group": "build",
            "command": "./start-devcontainer.sh",
            "options": {
              "cwd": "${workspaceFolder}/docker",
              "env": {},
            },
            "args" : [
                "${input:dev_image}",
                "${input:container_name}",
            ]
        },
        {
            "label": "Build and Upload Maxtext Snapshot",
            "type": "shell",
            "group": "build",
            "command": "${command:python.interpreterPath}",
            "options": {
              "cwd": "${workspaceFolder}/docker",
              "env": {},
            },
            "args" : [
                "${workspaceFolder}/docker/build.py",
                "--tag",
                "${input:container_name}",
                "--upload",
                "--framework",
                "maxtext",
                "--save_remote",
                "--remote",
                "${input:remote}",
            ]
        },
        {
            "label": "Commit and Upload Devcontainer",
            "type": "shell",
            "group": "build",
            "command": "./build.py",
            "options": {
              "cwd": "${workspaceFolder}/docker",
              "env": {},
            },
            "args" : [
                "--commit",
                "${input:container_name}",
                "--tag",
                "${input:container_name}",
                "--upload",
            ]
        },
        {
            "label": "Build and Validate Tag",
            "type": "shell",
            "group": "test",
            "command": "${command:python.interpreterPath}",
            "options": {
              "cwd": "${workspaceFolder}/docker",
              "env": {},
            },
            "args" : [
                "${workspaceFolder}/docker/build.py",
                "--validate",
                "medium",
                "--tag",
                "${input:container_name}",
                "--remote",
                "${input:remote}",
            ]
        },
        {
            "label": "Validate Tag",
            "type": "shell",
            "group": "test",
            "command": "${command:python.interpreterPath}",
            "options": {
              "cwd": "${workspaceFolder}/docker",
              "env": {},
            },
            "args" : [
                "${workspaceFolder}/docker/build.py",
                "--validate",
                "medium",
                "--tag",
                "${input:container_name}",
                "--remote",
                "${input:remote}",
            ]
        },
    ],
    "inputs": [
        {
            "id": "dev_image",
            "description": "The image name to run",
            "default": "legate-jax-dev:maxtext-devel",
            "type": "promptString"
        },
        {
            "id": "container_name",
            "description": "The container name/tag",
            "type": "promptString"
        },
        {
            "id": "remote",
            "description": "The remote server to run on",
            "default": "eos",
            "type": "promptString"
        },
    ]
}