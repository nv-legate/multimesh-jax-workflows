+def to_gspmd_sharding(s: XLACompatibleSharding, ndim: int,
+                      device_or_backend_set: bool = False) -> GSPMDSharding:
+  if isinstance(s, GSPMDSharding):
+    return s
+
+  # this is going to be an iota proto across a set of devices
+  # numbered 0 ... N for N local devices
+  xc_sharding = s._to_xla_hlo_sharding(ndim)
+
+  # translate the proto to its actual device assignemnt
+  if not s.is_fully_replicated:
+    iota_proto = xc_sharding.to_proto()
+    devices = [ d.id for d in s._device_assignment ]
+    is_iota = all(a==b for (a,b) in zip(devices, range(len(devices))))
+    if is_iota:
+      # if this is an iota proto, keep it
+      proto_sharding = iota_proto
+    else:
+      # non-iota submesh of devices
+      proto_sharding = xc.OpSharding()
+      proto_sharding.type = xe.OpSharding_Type.OTHER
+      proto_sharding.tile_assignment_dimensions = iota_proto.tile_assignment_dimensions
+      proto_sharding.tile_assignment_devices = devices
+      if iota_proto.last_tile_dims:
+        proto_sharding.last_tile_dims = iota_proto.last_tile_dims
+      proto_sharding.replicate_on_last_tile_dim = iota_proto.replicate_on_last_tile_dim
+    xc_sharding = xc.HloSharding.from_proto(proto_sharding)
+
+  gs = GSPMDSharding(s._device_assignment, xc_sharding,
+                      memory_kind=s.memory_kind)
+  gs._original_sharding = s
+  if device_or_backend_set:
+    gs._original_sharding._device_backend = device_or_backend_set
+  return gs
