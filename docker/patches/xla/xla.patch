+absl::StatusOr<ifrt::LoadedExecutable::ExecuteResult>
+MultiMeshLoadedExecutable::Execute(
+    absl::Span<tsl::RCReference<ifrt::Array>> args,
+    const ExecuteOptions& options,
+    std::optional<tsl::RCReference<ifrt::DeviceList>> devices) {
+  VLOG(3) << "MultiMeshLoadedExecutable::Execute: " << name();
+  std::vector<tsl::RCReference<ifrt::Array>> unwrapped_args;
+  unwrapped_args.reserve(args.size());
+  for (auto& arg : args) {
+    auto* arr = dynamic_cast<MultimeshIfrtArray*>(arg.get());
+    // I should be able to use the llvm cast, but this is not working
+    // and is returning non-null pointers for arrays that are not
+    // MultimeshIfrtArray
+    // MultimeshIfrtArray* arr =
+    // llvm::dyn_cast_or_null<MultimeshIfrtArray>(arg.get());
+    if (!arr) {
+      return InvalidArgument("Input is not a MultimeshIfrtArray");
+    }
+    auto* sanity =
+        dynamic_cast<ifrt::PjRtCompatibleArray*>(arr->wrapped().get());
+    if (!sanity) {
+      return InvalidArgument("wrapped array is not a PjRtArray");
+    }
+    VLOG(3) << exe_->name()
+            << " has input array with origin = " << (int)arr->origin();
+    unwrapped_args.push_back(arr->wrapped());
+  }
+  TF_ASSIGN_OR_RETURN(auto result, exe_->Execute(absl::MakeSpan(unwrapped_args),
+                                                 options, std::move(devices)));
+  ExecuteResult new_result;
+  new_result.status = std::move(result.status);
+  new_result.outputs.reserve(result.outputs.size());
+  for (const auto& arr : result.outputs) {
+    auto* ifrt_arr = llvm::dyn_cast<ifrt::PjRtArray>(arr.get());
+    if (!ifrt_arr) {
+      return InvalidArgument(
+          "Output of MultiMeshLoadedExecutable is not an ifrt::PjRtArray");
+    }
+    new_result.outputs.push_back(tsl::MakeRef<MultimeshIfrtArray>(
+        client_, std::move(arr), ArrayOrigin::Executable,
+        ifrt_arr->pjrt_buffers().front()->name()));
+  }
+  return new_result;
+}
