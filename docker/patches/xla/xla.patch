+PJRT_Error* PJRT_Executable_PackShardings(
+    PJRT_Executable_GetSharding_Args* args,
+    std::optional<std::vector<xla::OpSharding>> shardings) {
+  PJRT_RETURN_IF_ERROR(ActualStructSizeIsGreaterOrEqual(
+      "PJRT_Executable_GetSharding_Args",
+      PJRT_Executable_GetSharding_Args_STRUCT_SIZE, args->struct_size));
+
+  if (!shardings.has_value()) {
+    args->dump_size = 0;
+    return nullptr;
+  }
+
+  xla::OpSharding all_shardings;
+  for (const auto& sharding : *shardings) {
+    *all_shardings.add_tuple_shardings() = sharding;
+  }
+  if (all_shardings.ByteSizeLong() > args->dump_size) {
+    return new PJRT_Error{
+        xla::InvalidArgument("sharding vector is too big to pack")};
+  }
+
+  args->dump_size = all_shardings.ByteSizeLong();
+  bool success =
+      all_shardings.SerializeToArray(args->dump_data, args->dump_size);
+  if (!success) {
+    return new PJRT_Error{
+        xla::InvalidArgument("unknown error serializing OpSharding")};
+  }
+  return nullptr;
+}
