+MultimeshIfrtCompiler::Compile(std::unique_ptr<ifrt::Program> program,
+                               std::unique_ptr<ifrt::CompileOptions> options) {
+  TF_ASSIGN_OR_RETURN(auto exe,
+                      wrapped_.Compile(std::move(program), std::move(options)));
+
+  auto* pjrt_compat_exe = dynamic_cast<ifrt::PjRtLoadedExecutable*>(exe.get());
+  if (!pjrt_compat_exe) {
+    return InternalStrCat(
+        exe->name(),
+        " is not a PjRtCompatibleExecutable in MultimeshIfrtCompiler::Compile");
+  }
+  PjRtExecutable* pjrt_exe = pjrt_compat_exe->pjrt_loaded_executable();
+
+  TF_ASSIGN_OR_RETURN(auto param_layouts, pjrt_exe->GetParameterLayouts());
+  TF_ASSIGN_OR_RETURN(auto output_layouts, pjrt_exe->GetOutputLayouts());
+
+  return std::unique_ptr<ifrt::LoadedExecutable>(new MultiMeshLoadedExecutable(
+      client_, std::move(exe), std::move(param_layouts),
+      std::move(output_layouts), pjrt_exe->GetParameterShardings(),
+      pjrt_exe->GetOutputShardings()));
