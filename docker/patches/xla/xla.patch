+absl::StatusOr<std::vector<tsl::RCReference<ifrt::Array>>>
+MultimeshIfrtArray::DisassembleIntoSingleDeviceArrays(
+    ifrt::ArrayCopySemantics array_copy_semantics,
+    ifrt::SingleDeviceShardSemantics single_device_shard_semantics) {
+  return DisassembleIntoSingleDeviceArrays(array_copy_semantics);
+}
+
+absl::StatusOr<std::vector<tsl::RCReference<ifrt::Array>>>
+MultimeshIfrtArray::DisassembleIntoSingleDeviceArrays(
+    ifrt::ArrayCopySemantics semantics) {
+  VLOG(3) << "MultimeshIfrtArray::DisassembleIntoSingleDeviceArrays: " << name()
+          << ", shape=" << shape() << ", sharding=" << sharding()
+          << ", origin=" << (int)origin_;
+
+  auto* ifrt_array = llvm::dyn_cast<ifrt::PjRtArray>(wrapped_.get());
+  if (!ifrt_array) {
+    return InvalidArgument(
+        "MultimeshIfrtArray::DisassembleIntoSingleDeviceArrays: input is not a "
+        "ifrt::PjRtArray");
+  }
+
+  TF_ASSIGN_OR_RETURN(auto assembly,
+                      ifrt_array->sharding().Disassemble(shape()));
+
+  std::vector<std::shared_ptr<PjRtBuffer>> local_buffers;
+  local_buffers.reserve(ifrt_array->pjrt_buffers().size());
+
+  for (size_t idx = 0; idx < ifrt_array->pjrt_buffers().size(); ++idx) {
+    const auto& [shape, sharding] = assembly[idx];
+    VLOG(3) << "MultimeshIfrtArray::DisassembleIntoSingleDeviceArrays: shard "
+            << idx << " has shape=" << shape << ", sharding=" << *sharding;
+    // due to MPMD sharding, the buffers may end up being empty
+    // these should not be included in the slice operation
+    if (shape.dims().empty() || shape.num_elements() > 0) {
+      VLOG(5) << "  pushing back shard for "
+              << ifrt_array->pjrt_buffers()[idx]->name();
+      local_buffers.push_back(ifrt_array->pjrt_buffers()[idx]);
+    }
+  }
+
+  std::vector<tsl::RCReference<ifrt::Array>> new_arrays;
+  new_arrays.reserve(ifrt_array->pjrt_buffers().size());
+  size_t nonempty_idx = 0;
+  for (size_t idx = 0; idx < ifrt_array->pjrt_buffers().size(); ++idx) {
+    const auto& [shape, sharding] = assembly[idx];
+
+    if (shape.dims().empty() || shape.num_elements() > 0) {
+      auto next_buffer = std::move(local_buffers[nonempty_idx++]);
+      std::string name = next_buffer->name();
+
+      // this is such awfulness, I can't believe I have to do this
+      if (shape.dims().empty() && !next_buffer->HasValidShard()) {
+        continue;
+      }
+
+      TF_ASSIGN_OR_RETURN(auto layout, ifrt_array->layout());
+      TF_ASSIGN_OR_RETURN(
+          auto new_wrapped,
+          ifrt::PjRtArray::Create(ifrt_array->client(), ifrt_array->dtype(),
+                                  shape, sharding, {std::move(next_buffer)},
+                                  std::move(layout)));
+      new_arrays.push_back(tsl::MakeRef<MultimeshIfrtArray>(
+          client_, std::move(new_wrapped), ArrayOrigin::Disassemble,
+          std::move(name)));
+    }
+    VLOG(5) << "MultimeshIfrtArray::DisassembleIntoSingleDeviceArrays: shard "
+            << idx << " has shape=" << shape << ", sharding=" << *sharding;
+  }
+  return std::move(new_arrays);
+}
+
+std::string MultimeshIfrtArray::name() const {
+  if (name_.has_value()) {
+    return *name_;
+  }
+
+  switch (origin_) {
+    case ArrayOrigin::Assemble:
+      return "assembled";
+    case ArrayOrigin::Disassemble:
+      return "disassembled";
+    case ArrayOrigin::MakeArrayFromHostBuffer:
+      return "from_host_buffer";
+    case ArrayOrigin::Reshard:
+      return "reshard";
+    case ArrayOrigin::Executable:
+      return "executable";
+    case ArrayOrigin::FullyReplicatedShard:
+      return "fully_replicated_shard";
+    case ArrayOrigin::Copy:
+      return "copy";
+  }
+  return "unknown";
+}
+
+absl::StatusOr<tsl::RCReference<ifrt::Array>>
+MultimeshIfrtArray::FullyReplicatedShard(ifrt::ArrayCopySemantics semantics) {
+  VLOG(3) << "MultimeshIfrtArray::FullyReplicatedShard: semantics="
+          << (int)semantics << ", origin=" << (int)origin_
+          << ", name=" << name() << ", shape=" << shape()
+          << ", sharding=" << sharding();
+
+  if (semantics == ifrt::ArrayCopySemantics::kAlwaysCopy) {
+    return UnimplementedStrCat(
+        "MultimeshIfrtArray::FullyReplicatedShard: kAlwaysCopy not supported");
+  }
+
+  TF_ASSIGN_OR_RETURN(auto arrays,
+                      DisassembleIntoSingleDeviceArrays(semantics));
+
+  VLOG(3) << "MultimeshIfrtArray::FullyReplicatedShard: has " << arrays.size()
+          << " valid shards";
+
+  if (arrays.empty()) {
+    return InvalidArgumentStrCat(
+        "MultimeshIfrtArray::FullyReplicatedShard: ", shape().DebugString(),
+        " ", sharding().DebugString(), " has no shards");
+  }
+  // Disassemble should return only non-empty device arrays
+  return arrays[0];
+}
