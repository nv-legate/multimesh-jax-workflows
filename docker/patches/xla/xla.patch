+      std::move(shape), std::move(sharding), std::move(arrays), semantics,
+      ifrt::SingleDeviceShardSemantics::kAddressableShards);
+}
+
+absl::StatusOr<tsl::RCReference<ifrt::Array>>
+MultimeshIfrtClient::AssembleArrayFromSingleDeviceArrays(
+    ifrt::Shape shape,
+    absl::Nonnull<std::shared_ptr<const ifrt::Sharding>> sharding,
+    absl::Span<tsl::RCReference<ifrt::Array>> arrays,
+    ifrt::ArrayCopySemantics array_copy_semantics,
+    ifrt::SingleDeviceShardSemantics single_device_shard_semantics) {
+  if (arrays.empty()) {
+    return InvalidArgumentStrCat(
+        "MultimeshIfrtClient::AssembleArrayFromSingleDeviceArrays: arrays is "
+        "empty");
+  }
+  return AssembleArrayFromSingleDeviceArrays(
+      arrays[0]->dtype(), std::move(shape), std::move(sharding),
+      std::move(arrays), array_copy_semantics, single_device_shard_semantics);
+}
+
+absl::StatusOr<tsl::RCReference<ifrt::Array>>
+MultimeshIfrtClient::AssembleArrayFromSingleDeviceArrays(
+    ifrt::DType dtype, ifrt::Shape shape,
+    std::shared_ptr<const ifrt::Sharding> sharding,
+    absl::Span<tsl::RCReference<ifrt::Array>> arrays,
+    ifrt::ArrayCopySemantics array_copy_semantics,
+    ifrt::SingleDeviceShardSemantics single_device_shard_semantics) {
+  VLOG(3) << "MultimeshIfrtClient::AssembleArrayFromSingleDeviceArrays: "
+          << shape << ", " << *sharding;
+
+  auto* hlo_sharding = dynamic_cast<const ifrt::HloSharding*>(sharding.get());
+  if (!hlo_sharding) {
+    return InvalidArgument(
+        "MultimeshIfrtClient::AssembleArrayFromSingleDeviceArrays: "
+        "sharding is not an ifrt::HloSharding");
+  }
+
+  if (arrays.size() == 1 && hlo_sharding->xla_hlo_sharding().IsReplicated()) {
+    return arrays[0];
+  }
+
+  ifrt::PjRtCompatibleClient* pjrt_client = nullptr;
+  ifrt::PjRtArray::PjRtBuffers new_pjrt_buffers;
+  for (const auto& arr : arrays) {
+    MultimeshIfrtArray* mm_array =
+        llvm::dyn_cast_or_null<MultimeshIfrtArray>(arr.get());
+
+    ifrt::PjRtCompatibleArray* pjrt_arr =
+        llvm::dyn_cast_or_null<ifrt::PjRtCompatibleArray>(
+            mm_array->wrapped().get());
+    if (!pjrt_arr) {
+      return InvalidArgument(
+          "MultimeshIfrtArray::AssembleArrayFromSingleDeviceArrays: input is "
+          "not "
+          "an "
+          "ifrt::PjRtArray");
+    }
+    new_pjrt_buffers.push_back(pjrt_arr->pjrt_buffers().front());
+    if (pjrt_client == nullptr) {
+      pjrt_client =
+          dynamic_cast<ifrt::PjRtCompatibleClient*>(pjrt_arr->client());
+    }
+  }
+  std::string name = new_pjrt_buffers.front()->name();
+  auto layout = new_pjrt_buffers.front()->layout();
+  // TODO: support non-replicated sharding (e.g. for multi-device
+  TF_ASSIGN_OR_RETURN(
+      auto new_wrapped,
+      ifrt::PjRtArray::Create(pjrt_client, dtype, shape, sharding,
+                              std::move(new_pjrt_buffers), std::move(layout)));
+
+  return tsl::MakeRef<MultimeshIfrtArray>(
+      this, std::move(new_wrapped), ArrayOrigin::Assemble, std::move(name));
+}
