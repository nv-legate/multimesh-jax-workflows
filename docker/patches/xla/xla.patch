+std::optional<std::vector<OpSharding>> GetShardings(
+    PJRT_Executable_GetShardings fxn, const PJRT_Api* c_api,
+    PJRT_Executable* executable) {
+  PJRT_Executable_GetSharding_Args args;
+  args.struct_size = PJRT_Executable_GetSharding_Args_STRUCT_SIZE;
+  static constexpr size_t kMaxSize = 10e7;
+  std::string data(kMaxSize, ' ');
+  args.dump_data = data.data();
+  args.dump_size = data.size();
+  args.executable = executable;
+  auto* error = fxn(&args);
+  auto status = pjrt::PjrtErrorToStatus(error, c_api);
+  if (!status.ok() || args.dump_size == 0) {
+    return std::nullopt;
+  }
+
+  data.resize(args.dump_size);
+  OpSharding all_shardings;
+  all_shardings.ParseFromString(data);
+
+  std::vector<OpSharding> shardings;
+  shardings.reserve(all_shardings.tuple_shardings_size());
+  for (const auto& sharding : all_shardings.tuple_shardings()) {
+    shardings.push_back(sharding);
+  }
+  return shardings;
+}
