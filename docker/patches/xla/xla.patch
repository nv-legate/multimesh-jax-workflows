+absl::StatusOr<std::vector<tsl::RCReference<ifrt::Array>>>
+MultimeshIfrtClient::CopyArrays(
+    absl::Span<tsl::RCReference<ifrt::Array>> arrays,
+    std::optional<tsl::RCReference<ifrt::DeviceList>> devices,
+    std::optional<ifrt::MemoryKind> memory_kind,
+    ifrt::ArrayCopySemantics semantics) {
+  if (arrays.empty()) {
+    return std::vector<tsl::RCReference<ifrt::Array>>();
+  }
+
+  for (int i = 1; i < arrays.size(); ++i) {
+    const auto& sharding = arrays[i]->sharding();
+    if (*sharding.devices() != *arrays[0]->sharding().devices() ||
+        sharding.memory_kind() != arrays[0]->sharding().memory_kind()) {
+      return absl::InvalidArgumentError(
+          "CopyArrays only supports arrays with the same device list and "
+          "memory kind");
+    }
+  }
+
+  std::vector<tsl::RCReference<ifrt::Array>> new_arrays;
+  new_arrays.reserve(arrays.size());
+  for (const auto& array : arrays) {
+    if (auto* const pjrt_array = llvm::dyn_cast<ifrt::PjRtArray>(array.get())) {
+      TF_ASSIGN_OR_RETURN(new_arrays.emplace_back(),
+                          pjrt_array->Copy(devices, memory_kind, semantics));
+    } else if (auto* const string_array =
+                   llvm::dyn_cast<ifrt::BasicStringArray>(array.get())) {
+      TF_ASSIGN_OR_RETURN(new_arrays.emplace_back(),
+                          string_array->Copy(devices, memory_kind, semantics));
+    } else if (auto* const mm_array =
+                   dynamic_cast<MultimeshIfrtArray*>(array.get())) {
+      TF_ASSIGN_OR_RETURN(
+          auto new_pjrt_array,
+          llvm::dyn_cast<ifrt::PjRtArray>(mm_array->wrapped().get())
+              ->Copy(std::move(devices), memory_kind, semantics));
+      new_arrays.emplace_back(tsl::MakeRef<MultimeshIfrtArray>(
+          this, std::move(new_pjrt_array), ArrayOrigin::Copy,
+          mm_array->name()));
+    } else {
+      return absl::InvalidArgumentError(
+          "Unsupported array type for PjRtClient::CopyArrays");
+    }
+  }
+  return new_arrays;
+}
+
+absl::StatusOr<std::vector<tsl::RCReference<xla::ifrt::Array>>>
+MultimeshIfrtClient::RemapArrays(
+    const ifrt::RemapPlan& plan,
+    absl::Span<tsl::RCReference<xla::ifrt::Array>> arrays,
+    ifrt::ArrayCopySemantics semantics) {
+  std::vector<tsl::RCReference<ifrt::Array>> pjrt_input_arrays;
+  pjrt_input_arrays.reserve(arrays.size());
+  for (auto&& arr : arrays) {
+    auto* mm_array = dynamic_cast<MultimeshIfrtArray*>(arr.get());
+    pjrt_input_arrays.push_back(mm_array->wrapped());
+  }
+
+  TF_ASSIGN_OR_RETURN(
+      auto pjrt_output_arrays,
+      PjRtCompatibleClientRemapArrays(
+          pjrt_client_.get(), plan,
+          {pjrt_input_arrays.data(), pjrt_input_arrays.size()}, semantics));
+  std::vector<tsl::RCReference<ifrt::Array>> result;
+  result.reserve(pjrt_output_arrays.size());
+  for (auto&& arr : pjrt_output_arrays) {
+    result.push_back(tsl::MakeRef<MultimeshIfrtArray>(
+        this, std::move(arr), ArrayOrigin::Executable, "remapped"));
+  }
+  return std::move(result);
+}
