{
  "folders": [
    {
      "path": "multimesh-jax",
    },
    {
      "path": "xla",
    },
    {
      "path": "jax",
    },
    {
      "path": "maxtext",
    },
    {
      "path": "jax",
    },
    {
      "path": "zuku",
    },
    {
      "path": "realm"
    },
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
       {
        "label": "Compile MultiMesh-Jax",
        "type": "shell",
        "group": "build",
        "command": "cmake --build /opt/build/multimesh-jax",
        "options": {
          "cwd": "${workspaceFolder:multimesh-jax}",
          "env": {},
        },
        "problemMatcher": {
          "base": "$gcc",
          "fileLocation": ["absolute"]
        }
      },
      {
        "label": "Install MultiMesh-Jax",
        "type": "shell",
        "group": "build",
        "command": "cmake --install build",
        "options": {
          "cwd": "${workspaceFolder:multimesh-jax}",
          "env": {},
        },
      },
      {
        "label": "Build MultiMesh-Jax",
        "group": "build",
        "dependsOrder": "sequence",
        "dependsOn": ["Compile MultiMesh-Jax", "Install MultiMesh-Jax"],
      },
      {
        "label": "Run MPMD partition tests",
        "type": "shell",
        "group": "test",
        "command": "ctest",
        "options": {
          "cwd": "${workspaceFolder:multimesh-jax}",
          "env": {},
        },
        "args" : [
          "-j",
          "16",
          "--test-dir",
          "/opt/build/multimesh-jax",
          "-R",
          "MpmdPartitionTest.*",
        ]
      },
      {
        "label": "Run MPMD executable tests",
        "type": "shell",
        "group": "test",
        "command": "ctest",
        "options": {
          "cwd": "${workspaceFolder:multimesh-jax}",
          "env": {
            "CUDA_VISIBLE_DEVICES" : "0"
          },
        },
        "args" : [
          "--test-dir",
          "/opt/build/multimesh-jax",
          "-j",
          "16",
          "-R",
          "MultiMeshExecutableTest",
        ]
      },
      {
        "label": "Run JAX Python tests",
        "type": "shell",
        "group": "test",
        "command": "bash",
        "options": {
          "cwd": "${workspaceFolder:multimesh-jax}",
        },
        "args" : [
          "scripts/run-py-tests.sh",
        ]
      },
      {
        "label": "Run CI tests",
        "type": "shell",
        "group": "test",
        "command": "bash",
        "options": {
          "cwd": "${workspaceFolder:multimesh-jax}",
        },
        "args" : [
          "scripts/run-ci.sh",
        ]
      },
    ],
  },
  "launch": {
    "configurations": [
      {
        "name": "Python: Attach",
        "type": "python",
        "request": "attach",
        "connect": {
          "host": "localhost",
          "port": 5678
        }
      },
    ]
  },
  "settings": {
    "editor.formatOnSave": false,
  }
}
