{
  "name": "Legate-Jax Dev ${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localWorkspaceFolder}/.git,target=/.git,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/docker/workspace/build,target=/opt/build,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/docker/workspace/bazel,target=/root/.cache/bazel,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cache/ccache/realm,target=/ccache/realm,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cache/ccache/zuku,target=/ccache/zuku,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cache/ccache/legate-jax,target=/ccache/legate-jax,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/maxtext,target=/opt/workspace/maxtext-scripts,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/docker/workspace/mount,target=/opt/workspace/mount,type=bind,consistency=cached"
  ],
  "image": "legate-jax-dev:maxtext",
  "workspaceMount": "source=${localWorkspaceFolder}/docker/workspace,target=/opt/workspace,type=bind",
  "workspaceFolder": "/opt/workspace",
  "initializeCommand": "${localWorkspaceFolder}/.devcontainer/bootstrap-devcontainer.sh ${localWorkspaceFolder}",
  "postCreateCommand": "/opt/startup-devcontainer.sh",
  "runArgs": [
    "--name",
    "${localWorkspaceFolderBasename}_realm_jax_devcontainer",
    "--net=host",
    "--add-host=host.docker.internal:host-gateway",
    "--cap-add",
    "SYS_ADMIN",
    "--gpus",
    "all"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.vscode-pylance",
        "ms-python.python",
        "llvm-vs-code-extensions.vscode-clangd",
        "xaver.clang-format"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/install/miniconda/envs/legere/bin/python"
      }
    }
  }
}
